{
  // Cloudflare Worker "revisely" (revisely.app): the static site in /docs
  // (privacy, terms) and, under /api/, a small API for the app (worker/).
  // Only /api/* runs the worker code; every other path is served straight from
  // the assets. Cloudflare Workers Builds deploys it on each push to main.
  //
  // Secrets (never in this file; `npx wrangler@4.153.0 secret put <NAME>`):
  //   TCQ_API_KEY_LIVE     The Clear Quran API production key (tcq_eng_liv_…): the App
  //                        Store app, TestFlight and (for now) development builds
  //   TCQ_API_KEY_SANDBOX  The Clear Quran API sandbox key (tcq_eng_sbx_…): unused until
  //                        TCQ_API_BASE_SANDBOX names a sandbox host (worker/tcq.ts)
  // Both the dashboard (Settings → Variables and Secrets) and `secret put` act on
  // the newest version: they refuse if a branch build uploaded one after the last
  // deploy from main. Keep non-production branch builds off (CLAUDE.md, Worker).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revisely",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-12",
  "assets": {
    "directory": "docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Firebase project whose sign-in tokens the API accepts.
    "FIREBASE_PROJECT_ID": "revision-buddy-3a398",
    "TCQ_API_BASE_LIVE": "https://api.theclearquran.org",
    // Sandbox keys "only work against the sandbox API", and The Clear Quran
    // documents no sandbox host (only the base URL above, which refuses them).
    // Empty: development builds use the live key too. Set a sandbox host here
    // to send development builds to it with TCQ_API_KEY_SANDBOX.
    "TCQ_API_BASE_SANDBOX": "",
    // How long a data centre keeps a block of verses it fetched (0: not at all),
    // then serves it for TCQ_EDGE_STALE_SECONDS more while refreshing it. 30 + 30
    // days: The Clear Quran's terms don't address caching (owner's decision,
    // 2026-10-27). Lower these, or set 0, to dial back at once.
    "TCQ_EDGE_CACHE_SECONDS": "2592000",
    "TCQ_EDGE_STALE_SECONDS": "2592000",
    // How long the app may keep text on the phone (GET /api/tcq/policy), fresh
    // and then shown while refreshing; 0: nothing on the phone (it deletes its copies).
    "TCQ_DEVICE_CACHE_SECONDS": "2592000",
    "TCQ_DEVICE_STALE_SECONDS": "2592000",
    // Part of every cache key, here and on phones: change it to drop every copy.
    "TCQ_CACHE_VERSION": "1",
    // Requests to The Clear Quran a day (worker/budget.ts): 300 × 30 days stays
    // under the plan's 10,000 a month; no one account can take more than 150.
    "TCQ_DAILY_LIMIT_LIVE": "300",
    "TCQ_DAILY_LIMIT_SANDBOX": "100",
    "TCQ_USER_DAILY_LIMIT": "150"
  },
  // No stored request logs (they would hold which verses people read); use
  // `wrangler tail` to watch live.
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "TCQ_BUDGET", "class_name": "TcqBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TcqBudget"] }],
  // At most 30 verses a minute per signed-in user (the plan allows 5 a second
  // and 10,000 a month across everyone).
  "ratelimits": [
    {
      "name": "TCQ_USER_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Workers Builds runs `wrangler preview` for branches other than main, which
  // needs this block (previews inherit nothing). Previews get no API keys, so
  // /api/tcq answers 503 there and uses none of the plan.
  "previews": {
    "vars": {
      "FIREBASE_PROJECT_ID": "revision-buddy-3a398",
      "TCQ_API_BASE_LIVE": "https://api.theclearquran.org",
      "TCQ_API_BASE_SANDBOX": "",
      "TCQ_EDGE_CACHE_SECONDS": "0",
      "TCQ_EDGE_STALE_SECONDS": "0",
      "TCQ_DEVICE_CACHE_SECONDS": "0",
      "TCQ_DEVICE_STALE_SECONDS": "0",
      "TCQ_CACHE_VERSION": "1",
      "TCQ_DAILY_LIMIT_LIVE": "0",
      "TCQ_DAILY_LIMIT_SANDBOX": "0",
      "TCQ_USER_DAILY_LIMIT": "0"
    },
    "observability": { "enabled": false },
    "durable_objects": {
      "bindings": [{ "name": "TCQ_BUDGET", "class_name": "TcqBudget" }]
    },
    "ratelimits": [
      {
        "name": "TCQ_USER_LIMIT",
        "namespace_id": "1002",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  }
}
