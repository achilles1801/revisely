rules_version = '2';

/**
 * Firebase Storage rules for Revisely.
 *
 * - users/<uid>/profile/: the account's profile images (images, under 5 MB).
 * - recordings/<uid>/: backed-up recordings (lib/recordingBackup): audio only,
 *   at most 200 MB a file, readable, creatable and deletable only by the
 *   account, never overwritten (a name is one file, ever). Account deletion
 *   removes them on the server (functions deleteUserAccount).
 * - backups/: tester resets' backups (functions resetMyData), admin only.
 * - models/recite/: Recite's model for the phone and the on-device bench's files (Revisely Dev): read only by
 *   accounts with the onDeviceBench claim (functions/scripts/set-bench-access.js), written only by the admin SDK.
 * - packs/recite/: Recite's sealed pack (Revisely Dev): closed; phones read it through recitePack's signed URLs.
 * - The mushaf page images and the speech model are public objects served from
 *   storage.googleapis.com, outside these rules.
 * - Everything else is closed.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile images
    match /users/{userId}/profile/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) &&
                      request.resource.size < 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Backed-up recordings: <id>-<n>.m4a. Created, never updated: a second file
    // under a name already used is refused rather than replacing the first.
    match /recordings/{userId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       resource == null &&
                       fileName.matches('[A-Za-z0-9._-]+') &&
                       request.resource.size < 200 * 1024 * 1024 &&
                       request.resource.contentType.matches('audio/.*');
    }

    // Recite's model on the phone (Revisely Dev's on-device bench, BEHAVIOUR.md ONDEV-1): the models (watermarked),
    // the bench's clip and the checker's test vectors, put there by the team with the admin SDK. Revisely Dev is open
    // to anyone with its link, so signing in isn't enough: only accounts given the `onDeviceBench` claim
    // (functions/scripts/set-bench-access.js) read them. Nobody writes from a client. Nothing lives there on production.
    match /models/recite/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.onDeviceBench == true;
      allow write: if false;
    }

    // Recite's sealed pack (functions recitePack, Revisely Dev): no client reads it through these rules. A phone gets
    // a short-lived signed URL from the callable, after its checks. Written only by functions/scripts/recite-pack-make.js.
    match /packs/recite/{allPaths=**} {
      allow read, write: if false;
    }

    // Tester resets' backups (functions resetMyData): admin only, never a client.
    match /backups/{allPaths=**} {
      allow read, write: if false;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
