{
  "hosting": {
    "public": "public",
    "redirects": [
      {
        "regex": "^/([^_].*|_[^_].*|__[^/].*)?$",
        "destination": "https://revisely-dev.web.app/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      }
    ]
  }
}
