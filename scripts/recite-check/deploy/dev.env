# revisely-dev: the Dev app's checker. Sourced by deploy.sh; dev and production differ only in these files.
PROJECT=revisely-dev
PROJECT_NUMBER=433792838929
REGION=us-east1
SA=recite-check@revisely-dev.iam.gserviceaccount.com
REPO=us-east1-docker.pkg.dev/revisely-dev/cloud-run-source-deploy/recite-check  # where --source builds land
TAG=live                 # the tag a new revision gets before it takes traffic (https://live---recite-check-…)
SERVING_TAG=serving      # the image tag that marks what serves (the repository's keep policy keeps serving*, keep-*)
MIN_CHECK=0; MAX_CHECK=2 # recite-check: one take an instance
MIN_PAIR=0;  MAX_PAIR=2  # recite-check-pair: two takes an instance
# Each service's environment, '@'-separated (LEVELS holds a comma). TESTERS_ONLY is on by default (previewTester
# accounts); CHECK_GATE stays off (the Dev app gates Premium itself); App Check is counted, never refused.
# RECITE_WORDS_EAR=v7: Recite and Words & harakat on v7, v6 without Tadabur (engine.WORDS_EARS; Nov 18 2026). prod.env
# leaves it unset, so production stays on v6 with the same image. Unset it here (or set v6) to put dev back on v6.
# RECITE_EAR_EXPORT=fp32: the words ears' fixed exports (riwaya zeroed, full precision; engine.ear_file; Nov 18 2026),
# which measure what the gates did (the int8 files lose 0.7-0.8 points of professionals' planted slips). prod.env leaves
# it unset (production's int8 files, as before). Unset it here to go back.
ENV_COMMON="PROJECT=revisely-dev@BUCKET=revisely-dev.firebasestorage.app@THREADS=1@OMP_NUM_THREADS=1@APP_CHECK=log@PROJECT_NUMBER=433792838929@RECITE_WORDS_EAR=v7@RECITE_EAR_EXPORT=fp32"
ENV_CHECK="$ENV_COMMON"
ENV_PAIR="$ENV_COMMON@LEVELS=recite,harakat"
SOURCE_OK=1              # dev builds from source (Cloud Build); production only takes an image dev has run
