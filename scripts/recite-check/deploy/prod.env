# Production (revision-buddy-3a398): the store app's checker. NOTHING HERE EXISTS until Majd says yes
# (~/Documents/revisely-release/checker-prod.md). setup-prod.sh makes it once; deploy.sh then takes images dev has run.
PROJECT=revision-buddy-3a398
PROJECT_NUMBER=          # the project's number (setup-prod.sh prints it); App Check needs it, and deploy.sh refuses without
REGION=us-east1          # or europe-west1: Majd's call (checker-prod.md §3)
SA=recite-check@revision-buddy-3a398.iam.gserviceaccount.com
PROMOTE_SA=recite-check-promote@revision-buddy-3a398.iam.gserviceaccount.com  # copies images in (Cloud Build)
REPO=$REGION-docker.pkg.dev/revision-buddy-3a398/recite-check/recite-check
DEV_REPO=us-east1-docker.pkg.dev/revisely-dev/cloud-run-source-deploy/recite-check  # images come only from here
TAG=candidate
SERVING_TAG=serving
MIN_CHECK=0; MAX_CHECK=5 # the spending cap: 5 + 5 instances (about $760 a month if all ran all month)
MIN_PAIR=0;  MAX_PAIR=5
# Everyone signed in (no tester check); Mark mistakes needs entitlements/{uid}.premium (CHECK_GATE); App Check counted
# first (log), then refused without (on); nothing is kept (BUCKET empty); PAUSED=1 is the server's kill switch.
ENV_COMMON="PROJECT=revision-buddy-3a398@PROJECT_NUMBER=$PROJECT_NUMBER@TESTERS_ONLY=0@CHECK_GATE=on@APP_CHECK=log@BUCKET=@PAUSED=0@THREADS=1@OMP_NUM_THREADS=1"
ENV_CHECK="$ENV_COMMON"
ENV_PAIR="$ENV_COMMON@LEVELS=recite,harakat"
SOURCE_OK=0
