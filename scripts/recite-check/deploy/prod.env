# Production (revision-buddy-3a398): the store app's checker, set up with setup-prod.sh on Majd's word, Nov 18 2026
# (~/Documents/revisely-release/checker-prod.md). deploy.sh takes only images dev has run; every deploy is on his word.
PROJECT=revision-buddy-3a398
PROJECT_NUMBER=169239488140  # the project's number (setup-prod.sh step 1 checks it); App Check needs it
REGION=europe-west1      # Majd accepted europe-west1, Nov 17 2026 (checker-prod.md §3)
SA=recite-check@revision-buddy-3a398.iam.gserviceaccount.com
PROMOTE_SA=recite-check-promote@revision-buddy-3a398.iam.gserviceaccount.com  # copies images in (Cloud Build)
REPO=$REGION-docker.pkg.dev/revision-buddy-3a398/recite-check/recite-check
DEV_REPO=us-east1-docker.pkg.dev/revisely-dev/cloud-run-source-deploy/recite-check  # images come only from here
TAG=candidate
SERVING_TAG=serving
MIN_CHECK=0; MAX_CHECK=5 # the spending cap: 5 + 5 instances (about $760 a month if all ran all month)
MIN_PAIR=0;  MAX_PAIR=5
# Everyone signed in (no tester check); Mark mistakes needs entitlements/{uid}.premium (CHECK_GATE); App Check counted
# first (log), then refused without (on); nothing is kept (BUCKET empty); PAUSED=1 is the server's kill switch.
# RECITE_WORDS_EAR unset: Recite and Words & harakat on v6. RECITE_EAR_EXPORT=fp32 on recite-check (Mark mistakes): v6's
# fixed export (riwaya zeroed, full precision; engine.ear_file), which hears what the gates measured, as dev.env does with
# v7's (Majd's yes once checked on Dev, Nov 18 2026). The pair (Recite) stays on int8: two fixed-export takes saturate its
# one vCPU (README.md, "The words ears' fixed exports"). Rollback: drop it here and deploy the same image again, or move
# traffic back to the revision before.
ENV_COMMON="PROJECT=revision-buddy-3a398@PROJECT_NUMBER=$PROJECT_NUMBER@TESTERS_ONLY=0@CHECK_GATE=on@APP_CHECK=log@BUCKET=@PAUSED=0@THREADS=1@OMP_NUM_THREADS=1"
ENV_CHECK="$ENV_COMMON@RECITE_EAR_EXPORT=fp32"
ENV_PAIR="$ENV_COMMON@LEVELS=recite,harakat"
SOURCE_OK=0
