{
  "displayName": "Recitation checker: connections refused",
  "documentation": {"content": "More than 10 connections to the recitation checker answered 429 (no free instance) or 5xx in 15 minutes. Cloud Run answers these before the server sees them, so the health lines don't count them.", "mimeType": "text/markdown"},
  "combiner": "OR",
  "conditions": [
    {"displayName": "429s, 15 minutes",
     "conditionThreshold": {
       "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=starts_with(\"recite-check\") AND metric.labels.response_code=\"429\"",
       "aggregations": [{"alignmentPeriod": "900s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM"}],
       "comparison": "COMPARISON_GT", "thresholdValue": 10, "duration": "0s"}},
    {"displayName": "5xx, 15 minutes",
     "conditionThreshold": {
       "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=starts_with(\"recite-check\") AND metric.labels.response_code_class=\"5xx\"",
       "aggregations": [{"alignmentPeriod": "900s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM"}],
       "comparison": "COMPARISON_GT", "thresholdValue": 10, "duration": "0s"}}
  ],
  "alertStrategy": {"autoClose": "86400s"},
  "notificationChannels": ["__CHANNEL__"]
}
