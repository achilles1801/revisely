{
  "displayName": "Recitation checker: errors",
  "documentation": {"content": "More than 5 `health=error` lines in 15 minutes on the recitation checker (scripts/recite-check/health.py). Read them: gcloud logging read 'jsonPayload.health=\"error\"'. Switching it off: checker-prod.md, \"Switching it off\".", "mimeType": "text/markdown"},
  "combiner": "OR",
  "conditions": [{
    "displayName": "error lines, 15 minutes",
    "conditionThreshold": {
      "filter": "metric.type=\"logging.googleapis.com/user/recite_check_errors\" AND resource.type=\"cloud_run_revision\"",
      "aggregations": [{"alignmentPeriod": "900s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM"}],
      "comparison": "COMPARISON_GT", "thresholdValue": 5, "duration": "0s"
    }
  }],
  "alertStrategy": {"autoClose": "86400s"},
  "notificationChannels": ["__CHANNEL__"]
}
