{"version":1,"credit":"Arabic text: Tanzil Project · tanzil.net","parts":[{"n":1,"title":"Part 1","minutes":20},{"n":2,"title":"Part 2","minutes":15,"note":"If you have time. It helps a lot."}],"groups":[{"id":"normal","part":1,"title":"Recite as you normally do","note":"From memory if you know it. If not, tap Show text and read it."},{"id":"natural","part":1,"title":"Natural slips","note":"Things people do all the time that are not mistakes. The checker must not flag them."},{"id":"word","part":1,"title":"Word mistakes, on purpose","note":"Make exactly the mistake described, and recite the rest correctly."},{"id":"letter","part":2,"title":"Letter and haraka mistakes, on purpose","note":"Make exactly the mistake described, and recite the rest correctly."},{"id":"tajweed","part":2,"title":"Tajweed, on purpose","note":"Make exactly the change described, and recite the rest with your usual tajweed."},{"id":"place","part":2,"title":"Other places","note":"Your normal recitation, somewhere less quiet."}],"items":[{"id":"n1","part":1,"group":"normal","title":"Al-Fātiḥah","note":"Start with أَعُوذُ بِٱللَّهِ مِنَ ٱلشَّيْطَـٰنِ ٱلرَّجِيمِ as you normally would, then the whole surah.","ayat":[{"s":1,"a":1,"words":["بِسْمِ","ٱللَّهِ","ٱلرَّحْمَـٰنِ","ٱلرَّحِيمِ"]},{"s":1,"a":2,"words":["ٱلْحَمْدُ","لِلَّهِ","رَبِّ","ٱلْعَـٰلَمِينَ"]},{"s":1,"a":3,"words":["ٱلرَّحْمَـٰنِ","ٱلرَّحِيمِ"]},{"s":1,"a":4,"words":["مَـٰلِكِ","يَوْمِ","ٱلدِّينِ"]},{"s":1,"a":5,"words":["إِيَّاكَ","نَعْبُدُ","وَإِيَّاكَ","نَسْتَعِينُ"]},{"s":1,"a":6,"words":["ٱهْدِنَا","ٱلصِّرَٰطَ","ٱلْمُسْتَقِيمَ"]},{"s":1,"a":7,"words":["صِرَٰطَ","ٱلَّذِينَ","أَنْعَمْتَ","عَلَيْهِمْ","غَيْرِ","ٱلْمَغْضُوبِ","عَلَيْهِمْ","وَلَا","ٱلضَّآلِّينَ"]}],"marks":[],"show":false,"truth":{"kind":"correct"},"istiadha":true},{"id":"n2","part":1,"group":"normal","title":"Al-Baqarah 1–5","note":"The first five ayat.","ayat":[{"s":2,"a":1,"words":["الٓمٓ"]},{"s":2,"a":2,"words":["ذَٰلِكَ","ٱلْكِتَـٰبُ","لَا","رَيْبَ","فِيهِ","هُدًۭى","لِّلْمُتَّقِينَ"]},{"s":2,"a":3,"words":["ٱلَّذِينَ","يُؤْمِنُونَ","بِٱلْغَيْبِ","وَيُقِيمُونَ","ٱلصَّلَوٰةَ","وَمِمَّا","رَزَقْنَـٰهُمْ","يُنفِقُونَ"]},{"s":2,"a":4,"words":["وَٱلَّذِينَ","يُؤْمِنُونَ","بِمَآ","أُنزِلَ","إِلَيْكَ","وَمَآ","أُنزِلَ","مِن","قَبْلِكَ","وَبِٱلْـَٔاخِرَةِ","هُمْ","يُوقِنُونَ"]},{"s":2,"a":5,"words":["أُو۟لَـٰٓئِكَ","عَلَىٰ","هُدًۭى","مِّن","رَّبِّهِمْ","وَأُو۟لَـٰٓئِكَ","هُمُ","ٱلْمُفْلِحُونَ"]}],"marks":[],"show":false,"truth":{"kind":"correct"}},{"id":"n3","part":1,"group":"normal","title":"Āyat al-Kursī","note":"Al-Baqarah 255, just this one ayah.","ayat":[{"s":2,"a":255,"words":["ٱللَّهُ","لَآ","إِلَـٰهَ","إِلَّا","هُوَ","ٱلْحَىُّ","ٱلْقَيُّومُ","لَا","تَأْخُذُهُۥ","سِنَةٌۭ","وَلَا","نَوْمٌۭ","لَّهُۥ","مَا","فِى","ٱلسَّمَـٰوَٰتِ","وَمَا","فِى","ٱلْأَرْضِ","مَن","ذَا","ٱلَّذِى","يَشْفَعُ","عِندَهُۥٓ","إِلَّا","بِإِذْنِهِۦ","يَعْلَمُ","مَا","بَيْنَ","أَيْدِيهِمْ","وَمَا","خَلْفَهُمْ","وَلَا","يُحِيطُونَ","بِشَىْءٍۢ","مِّنْ","عِلْمِهِۦٓ","إِلَّا","بِمَا","شَآءَ","وَسِعَ","كُرْسِيُّهُ","ٱلسَّمَـٰوَٰتِ","وَٱلْأَرْضَ","وَلَا","يَـُٔودُهُۥ","حِفْظُهُمَا","وَهُوَ","ٱلْعَلِىُّ","ٱلْعَظِيمُ"]}],"marks":[],"show":false,"truth":{"kind":"correct"}},{"id":"n4","part":1,"group":"normal","title":"Al-Baqarah 285–286","note":"The last two ayat of Al-Baqarah.","ayat":[{"s":2,"a":285,"words":["ءَامَنَ","ٱلرَّسُولُ","بِمَآ","أُنزِلَ","إِلَيْهِ","مِن","رَّبِّهِۦ","وَٱلْمُؤْمِنُونَ","كُلٌّ","ءَامَنَ","بِٱللَّهِ","وَمَلَـٰٓئِكَتِهِۦ","وَكُتُبِهِۦ","وَرُسُلِهِۦ","لَا","نُفَرِّقُ","بَيْنَ","أَحَدٍۢ","مِّن","رُّسُلِهِۦ","وَقَالُوا۟","سَمِعْنَا","وَأَطَعْنَا","غُفْرَانَكَ","رَبَّنَا","وَإِلَيْكَ","ٱلْمَصِيرُ"]},{"s":2,"a":286,"words":["لَا","يُكَلِّفُ","ٱللَّهُ","نَفْسًا","إِلَّا","وُسْعَهَا","لَهَا","مَا","كَسَبَتْ","وَعَلَيْهَا","مَا","ٱكْتَسَبَتْ","رَبَّنَا","لَا","تُؤَاخِذْنَآ","إِن","نَّسِينَآ","أَوْ","أَخْطَأْنَا","رَبَّنَا","وَلَا","تَحْمِلْ","عَلَيْنَآ","إِصْرًۭا","كَمَا","حَمَلْتَهُۥ","عَلَى","ٱلَّذِينَ","مِن","قَبْلِنَا","رَبَّنَا","وَلَا","تُحَمِّلْنَا","مَا","لَا","طَاقَةَ","لَنَا","بِهِۦ","وَٱعْفُ","عَنَّا","وَٱغْفِرْ","لَنَا","وَٱرْحَمْنَآ","أَنتَ","مَوْلَىٰنَا","فَٱنصُرْنَا","عَلَى","ٱلْقَوْمِ","ٱلْكَـٰفِرِينَ"]}],"marks":[],"show":false,"truth":{"kind":"correct"}},{"id":"n5","part":1,"group":"normal","title":"Al-Mulk 1–10","note":"Start with أَعُوذُ بِٱللَّهِ مِنَ ٱلشَّيْطَـٰنِ ٱلرَّجِيمِ and the basmala, as you normally would.","ayat":[{"s":67,"a":1,"words":["تَبَـٰرَكَ","ٱلَّذِى","بِيَدِهِ","ٱلْمُلْكُ","وَهُوَ","عَلَىٰ","كُلِّ","شَىْءٍۢ","قَدِيرٌ"]},{"s":67,"a":2,"words":["ٱلَّذِى","خَلَقَ","ٱلْمَوْتَ","وَٱلْحَيَوٰةَ","لِيَبْلُوَكُمْ","أَيُّكُمْ","أَحْسَنُ","عَمَلًۭا","وَهُوَ","ٱلْعَزِيزُ","ٱلْغَفُورُ"]},{"s":67,"a":3,"words":["ٱلَّذِى","خَلَقَ","سَبْعَ","سَمَـٰوَٰتٍۢ","طِبَاقًۭا","مَّا","تَرَىٰ","فِى","خَلْقِ","ٱلرَّحْمَـٰنِ","مِن","تَفَـٰوُتٍۢ","فَٱرْجِعِ","ٱلْبَصَرَ","هَلْ","تَرَىٰ","مِن","فُطُورٍۢ"]},{"s":67,"a":4,"words":["ثُمَّ","ٱرْجِعِ","ٱلْبَصَرَ","كَرَّتَيْنِ","يَنقَلِبْ","إِلَيْكَ","ٱلْبَصَرُ","خَاسِئًۭا","وَهُوَ","حَسِيرٌۭ"]},{"s":67,"a":5,"words":["وَلَقَدْ","زَيَّنَّا","ٱلسَّمَآءَ","ٱلدُّنْيَا","بِمَصَـٰبِيحَ","وَجَعَلْنَـٰهَا","رُجُومًۭا","لِّلشَّيَـٰطِينِ","وَأَعْتَدْنَا","لَهُمْ","عَذَابَ","ٱلسَّعِيرِ"]},{"s":67,"a":6,"words":["وَلِلَّذِينَ","كَفَرُوا۟","بِرَبِّهِمْ","عَذَابُ","جَهَنَّمَ","وَبِئْسَ","ٱلْمَصِيرُ"]},{"s":67,"a":7,"words":["إِذَآ","أُلْقُوا۟","فِيهَا","سَمِعُوا۟","لَهَا","شَهِيقًۭا","وَهِىَ","تَفُورُ"]},{"s":67,"a":8,"words":["تَكَادُ","تَمَيَّزُ","مِنَ","ٱلْغَيْظِ","كُلَّمَآ","أُلْقِىَ","فِيهَا","فَوْجٌۭ","سَأَلَهُمْ","خَزَنَتُهَآ","أَلَمْ","يَأْتِكُمْ","نَذِيرٌۭ"]},{"s":67,"a":9,"words":["قَالُوا۟","بَلَىٰ","قَدْ","جَآءَنَا","نَذِيرٌۭ","فَكَذَّبْنَا","وَقُلْنَا","مَا","نَزَّلَ","ٱللَّهُ","مِن","شَىْءٍ","إِنْ","أَنتُمْ","إِلَّا","فِى","ضَلَـٰلٍۢ","كَبِيرٍۢ"]},{"s":67,"a":10,"words":["وَقَالُوا۟","لَوْ","كُنَّا","نَسْمَعُ","أَوْ","نَعْقِلُ","مَا","كُنَّا","فِىٓ","أَصْحَـٰبِ","ٱلسَّعِيرِ"]}],"marks":[],"show":false,"truth":{"kind":"correct"},"istiadha":tru