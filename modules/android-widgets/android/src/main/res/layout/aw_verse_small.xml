<?xml version="1.0" encoding="utf-8"?>
<!-- Verse of the day, 2×2 (the default). The Arabic is drawn in Amiri to a bitmap (RemoteViews can't take a font). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/aw_ground"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
      android:layout_width="wrap_content"
      android:layout_height="14dp"
      android:adjustViewBounds="true"
      android:importantForAccessibility="no"
      android:scaleType="fitCenter"
      android:src="@drawable/aw_r_mark" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/aw_verse_of_the_day"
      android:textColor="@color/aw_secondary"
      android:textSize="12sp" />
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:minHeight="4dp" />

  <ImageView
    android:id="@+id/aw_arabic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:adjustViewBounds="true"
    android:scaleType="fitCenter"
    android:src="@drawable/aw_preview_verse"
    android:tint="@color/aw_text" />

  <TextView
    android:id="@+id/aw_open"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:text="@string/aw_open_revisely"
    android:textColor="@color/aw_secondary"
    android:textSize="13sp"
    android:visibility="gone" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:minHeight="4dp" />

  <TextView
    android:id="@+id/aw_reference"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center_horizontal"
    android:maxLines="1"
    android:text="@string/aw_sample_reference"
    android:textColor="@color/aw_secondary"
    android:textSize="12sp" />
</LinearLayout>
