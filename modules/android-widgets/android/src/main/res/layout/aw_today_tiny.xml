<?xml version="1.0" encoding="utf-8"?>
<!-- Today, 2×1: what is left over where it starts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/aw_ground"
  android:clipToOutline="true"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="14dp">

  <FrameLayout
    android:layout_width="32dp"
    android:layout_height="32dp">
    <ImageView
      android:id="@+id/aw_mark_circle"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:src="@drawable/aw_circle"
      android:tint="@color/aw_fill" />
    <ImageView
      android:id="@+id/aw_mark_r"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:padding="8dp"
      android:scaleType="fitCenter"
      android:src="@drawable/aw_r_mark" />
    <ImageView
      android:id="@+id/aw_mark_check"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:padding="7dp"
      android:scaleType="fitCenter"
      android:src="@drawable/aw_check"
      android:visibility="gone" />
  </FrameLayout>

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      android:id="@+id/aw_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/aw_sample_left"
      android:textColor="@color/aw_text"
      android:textSize="15sp" />
    <TextView
      android:id="@+id/aw_line"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/aw_sample_title"
      android:textColor="@color/aw_secondary"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
