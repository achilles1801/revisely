<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer times, 4×1: the five prayers in a row, the next on the accent's tint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/aw_ground"
  android:clipToOutline="true"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:padding="10dp">
  <FrameLayout
    android:id="@+id/aw_cell0"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_weight="1">
    <ImageView
      android:id="@+id/aw_cell0_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/aw_cell"
      android:tint="@color/aw_fill"
      android:visibility="invisible" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <TextView
        android:id="@+id/aw_cell0_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/aw_sample_fajr"
        android:textColor="@color/aw_secondary"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/aw_cell0_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="@string/aw_sample_fajr_short"
        android:textColor="@color/aw_secondary"
        android:textSize="15sp" />
    </LinearLayout>
  </FrameLayout>
  <FrameLayout
    android:id="@+id/aw_cell1"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_weight="1">
    <ImageView
      android:id="@+id/aw_cell1_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/aw_cell"
      android:tint="@color/aw_fill"
      android:visibility="invisible" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <TextView
        android:id="@+id/aw_cell1_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/aw_sample_dhuhr"
        android:textColor="@color/aw_secondary"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/aw_cell1_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="@string/aw_sample_dhuhr_short"
        android:textColor="@color/aw_text"
        android:textSize="15sp" />
    </LinearLayout>
  </FrameLayout>
  <FrameLayout
    android:id="@+id/aw_cell2"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_weight="1">
    <ImageView
      android:id="@+id/aw_cell2_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/aw_cell"
      android:tint="@color/aw_fill"
      android:visibility="visible" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <TextView
        android:id="@+id/aw_cell2_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/aw_sample_prayer"
        android:textColor="@color/aw_preview_accent"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/aw_cell2_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="@string/aw_sample_asr_short"
        android:textColor="@color/aw_preview_accent"
        android:textSize="15sp" />
    </LinearLayout>
  </FrameLayout>
  <FrameLayout
    android:id="@+id/aw_cell3"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_weight="1">
    <ImageView
      android:id="@+id/aw_cell3_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/aw_cell"
      android:tint="@color/aw_fill"
      android:visibility="invisible" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <TextView
        android:id="@+id/aw_cell3_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/aw_sample_maghrib"
        android:textColor="@color/aw_secondary"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/aw_cell3_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="@string/aw_sample_maghrib_short"
        android:textColor="@color/aw_text"
        android:textSize="15sp" />
    </LinearLayout>
  </FrameLayout>
  <FrameLayout
    android:id="@+id/aw_cell4"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_weight="1">
    <ImageView
      android:id="@+id/aw_cell4_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/aw_cell"
      android:tint="@color/aw_fill"
      android:visibility="invisible" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <TextView
        android:id="@+id/aw_cell4_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/aw_sample_isha"
        android:textColor="@color/aw_secondary"
        android:textSize="12sp" />
      <TextView
        android:id="@+id/aw_cell4_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="@string/aw_sample_isha_short"
        android:textColor="@color/aw_text"
        android:textSize="15sp" />
    </LinearLayout>
  </FrameLayout>
  <TextView
    android:id="@+id/aw_open"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="2"
    android:textColor="@color/aw_secondary"
    android:textSize="13sp"
    android:visibility="gone" />
</LinearLayout>
