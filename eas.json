{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "preview-simulator": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },
    "dev": {
      "autoIncrement": true,
      "channel": "dev",
      "environment": "development",
      "env": {
        "APP_VARIANT": "dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6767990248",
        "appleTeamId": "CH8N5V9MA6"
      },
      "android": {
        "serviceAccountKeyPath": "$PLAY_SERVICE_ACCOUNT_KEY_PATH",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "dev": {
      "ios": {
        "ascAppId": "6833565026",
        "appleTeamId": "CH8N5V9MA6"
      },
      "android": {
        "serviceAccountKeyPath": "$PLAY_SERVICE_ACCOUNT_KEY_PATH",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
